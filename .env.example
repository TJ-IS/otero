# Copy to .env and adjust for your environment.
# MinerU API token for PDF parsing.
OTERO_MINERU_TOKEN=""
OTERO_MINERU_MODEL="vlm"

# LLM provider for calibration and extraction.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-v4-flash"

# Comma-separated EVM addresses that are allowed to edit project data.
OTERO_EDITOR_WHITELIST=0x7d7984e2ea378465a0e759df675f9d295e566017

# JWT signing secret. Change this in production.
OTERO_AUTH_SECRET=change-me-in-production

# Storage backend: 'filesystem' (default, keeps PDFs on disk) or 'minio'.
STORAGE_TYPE=filesystem

# MinIO / S3-compatible object storage (only used when STORAGE_TYPE=minio).
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=otero
MINIO_SECRET_KEY=otero-secret-change-me
MINIO_BUCKET=otero-pdfs

# PostgreSQL (required). docker compose service name is `postgres`.
POSTGRES_USER=otero
POSTGRES_PASSWORD=otero-secret-change-me
POSTGRES_DB=otero
POSTGRES_PORT=5432
# Host tooling uses 127.0.0.1; inside compose the otero service overrides
# hostname to `postgres` via docker-compose.yml environment.
DATABASE_URL=postgresql://otero:otero-secret-change-me@127.0.0.1:5432/otero
