# Copy to .env and adjust for your environment.

# PostgreSQL 18 (required). DATABASE_URL is the ONLY database configuration
# entry: Otero does not ship, start, or manage a PostgreSQL container. Prepare
# your own PostgreSQL 18 instance and point this URL at it.
# Tools running directly on the host use 127.0.0.1. From inside a container,
# use an address reachable from that container instead (for example the host's
# LAN IP; docker-compose.prod.yml and the 1Panel template map
# host.docker.internal for Linux).
DATABASE_URL=postgresql://otero:otero-secret-change-me@127.0.0.1:5432/otero
# Remote databases, or a database without TLS, need their own host/params.
# If the server does not enable TLS you must append ?sslmode=disable, e.g.
#   DATABASE_URL=postgresql://otero:<password>@db.example.com:5432/otero?sslmode=disable

# Storage: 'filesystem' (PDFs under data/storage) or 's3' (R2 / any S3 API).
STORAGE_TYPE=filesystem

# Cloudflare R2 example (S3 API endpoint — NOT the public custom domain):
#   STORAGE_TYPE=s3
#   S3_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_PORT=443
#   S3_USE_SSL=true
#   S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
#   S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
#   S3_BUCKET=otero-pdfs
#   S3_REGION=auto
#   S3_CREATE_BUCKET=false
S3_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PORT=443
S3_USE_SSL=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=otero-pdfs
S3_REGION=auto
S3_CREATE_BUCKET=false

# MinerU API token for PDF → Markdown full text.
# Extra keys rotate on 429 / auth / quota errors:
#   OTERO_MINERU_TOKEN_2=...
#   OTERO_MINERU_TOKENS=tokA,tokB
OTERO_MINERU_TOKEN=""
# OTERO_MINERU_TOKEN_2=""
# OTERO_MINERU_TOKENS=""
OTERO_MINERU_MODEL="vlm"
# OTERO_MINERU_POLL_MS=15000
# OTERO_MINERU_MAX_CONCURRENT=3
# OTERO_MINERU_BATCH_SIZE=200

# LLM (calibrate / extract / chat). OpenAI-compatible.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-v4-flash"

# Bootstrap admin wallets (comma-separated) and JWT signing secret.
# Whitelist addresses are seeded as admins and cannot be demoted.
OTERO_EDITOR_WHITELIST=0x7d7984e2ea378465a0e759df675f9d295e566017
OTERO_AUTH_SECRET=change-me-in-production
# Optional dedicated HMAC secret for short-lived PDF URLs (falls back to OTERO_AUTH_SECRET).
# OTERO_PDF_SIGNING_SECRET=
# OTERO_PDF_URL_TTL_SEC=600

# Public site origin for canonical URLs, sitemap, og:url, and llms.txt.
PUBLIC_BASE_URL=https://ais-basket.xyz
# PUBLIC_OG_IMAGE=/og.png
# GOOGLE_SITE_VERIFICATION=
# 301 non-canonical Host headers to PUBLIC_BASE_URL (leave off in local/dev).
# OTERO_ENFORCE_CANONICAL_HOST=1

# Optional listen bind (local npm run serve).
# OTERO_PORT=3000
# OTERO_HOST=127.0.0.1
