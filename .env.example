# Copy to .env and adjust for your environment.
# MinerU API token for PDF parsing.
OTERO_MINERU_TOKEN=""
OTERO_MINERU_MODEL="vlm"

# LLM provider for calibration and extraction.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-v4-flash"

# Comma-separated EVM addresses that are allowed to edit project data.
OTERO_EDITOR_WHITELIST=0x7d7984e2ea378465a0e759df675f9d295e566017

# JWT signing secret. Change this in production.
OTERO_AUTH_SECRET=change-me-in-production

# Storage backend: 'filesystem' (default, keeps PDFs on disk) or 's3'
# ('s3' covers Cloudflare R2, AWS S3, local MinIO — any S3-compatible API).
STORAGE_TYPE=filesystem

# S3-compatible object storage (Cloudflare R2, AWS S3, …).
# For Cloudflare R2 (S3 API — NOT the public custom domain):
#   S3_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_PORT=443
#   S3_USE_SSL=true
#   S3_REGION=auto
#   S3_CREATE_BUCKET=false
S3_ENDPOINT=127.0.0.1
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=otero
S3_SECRET_KEY=otero-secret-change-me
S3_BUCKET=otero-pdfs
S3_REGION=auto
S3_CREATE_BUCKET=true

# PostgreSQL (required). docker compose service name is `postgres`.
POSTGRES_USER=otero
POSTGRES_PASSWORD=otero-secret-change-me
POSTGRES_DB=otero
POSTGRES_PORT=5432
# Host tooling uses 127.0.0.1; inside compose the otero service overrides
# hostname to `postgres` via docker-compose.yml environment.
DATABASE_URL=postgresql://otero:otero-secret-change-me@127.0.0.1:5432/otero
