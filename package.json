{
  "name": "otero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Zotero-like literature management system in pure JS with PostgreSQL storage.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "cli": "node src/cli/index.js",
    "serve": "node src/index.js --serve",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/**/*.test.js\""
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.7",
    "adm-zip": "^0.5.16",
    "ai": "^7.0.20",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "jose": "^6.2.3",
    "minio": "^8.0.7",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.7.76",
    "pg": "^8.22.0",
    "viem": "^2.55.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
