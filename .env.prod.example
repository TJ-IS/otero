# Otero 生产部署环境变量模板
# ---------------------------------------------------------------------------
# 用法：复制为 .env，逐项替换 <> 占位符后执行
#   docker compose -f docker-compose.prod.yml up -d
#
# 本文件只含占位符，切勿把真实密钥提交到仓库；.env 已被 .gitignore 忽略。
# 建议：chmod 600 .env
# ---------------------------------------------------------------------------

# ===== 镜像 =====
# 要部署的镜像标签。生产建议固定到具体版本（如 1.2.3 或 sha-abc1234），
# 便于复现与回滚。注意：git tag 为 v1.2.3 时，生成的镜像标签是 1.2.3（去掉 v）。
# 填 latest 则每次 pull 获取最新构建。
OTERO_IMAGE_TAG=latest

# ===== PostgreSQL =====
# 数据库由你自行部署，不在 compose 内，连接方式由你通过 DATABASE_URL 提供。
# 要求 PostgreSQL 18，应用使用 schema v6，启动迁移时会自动建表
# （需提前创建好数据库与用户）。
# 连接串格式：
#   postgresql://<用户>:<密码>@<主机>:<端口>/<数据库名>
#
# 场景一：数据库与容器在同一台宿主机上。
# compose 已配置 extra_hosts，Linux / macOS / Windows 都可直接用
# host.docker.internal 访问宿主机。（若数据库只监听 127.0.0.1，
# 需改为监听 0.0.0.0 或 Docker 网桥地址，详见 docs/deploy.md。）
DATABASE_URL=postgresql://otero:<DB_PASSWORD>@host.docker.internal:5432/otero
#
# 场景二：远程数据库。
# DATABASE_URL=postgresql://otero:<DB_PASSWORD>@db.example.com:5432/otero
#
# 若数据库要求 TLS，在 URL 末尾加 ?sslmode=require：
# DATABASE_URL=postgresql://otero:<DB_PASSWORD>@db.example.com:5432/otero?sslmode=require
#
# 注意：密码中的 @ : / ? # [ ] 等特殊字符必须做 URL 编码
# （例如 @ → %40，/ → %2F），否则连接串会被解析错位。

# ===== 对象存储 =====
# 存储后端：filesystem（存到 ./data/storage）或 s3（Cloudflare R2 / 任意 S3 兼容）。
STORAGE_TYPE=s3
# R2 的 S3 API 端点，格式为 <ACCOUNT_ID>.r2.cloudflarestorage.com
# 注意：不要填公共自定义域名。
S3_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3 端口，R2 使用 443。
S3_PORT=443
# 是否使用 TLS，R2 填 true。
S3_USE_SSL=true
# R2 Access Key ID。
S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# R2 Secret Access Key。
S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# 存放 PDF / 全文的 bucket 名称（需提前在 R2 创建）。
S3_BUCKET=otero-pdfs
# R2 固定填 auto；其他 S3 兼容服务按厂商要求填写。
S3_REGION=auto
# 是否让应用自动创建 bucket。托管 R2 请保持 false（在控制台创建）。
S3_CREATE_BUCKET=false

# ===== MinerU（PDF → Markdown 全文解析）=====
# MinerU API Token，在 https://mineru.net 申请。
OTERO_MINERU_TOKEN=<MINERU_TOKEN>
# MinerU 模型版本，通常为 vlm。
OTERO_MINERU_MODEL=vlm

# ===== LLM（题录校准 / 字段抽取 / 条目对话）=====
# OpenAI 兼容 API Key。
OPENAI_API_KEY=<OPENAI_API_KEY>
# OpenAI 兼容 API 地址；也可换成任意兼容服务。
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 使用的模型名称。
OPENAI_MODEL=deepseek-v4-flash

# ===== 鉴权 =====
# 允许写入的编辑者钱包地址，逗号分隔（会作为管理员种子写入）。
# 留空则站点只读；多个地址示例：0xabc...,0xdef...
OTERO_EDITOR_WHITELIST=<EDITOR_WALLET_ADDRESS>
# JWT 与 PDF 短链签名密钥。必须替换，请用以下命令生成：
#   openssl rand -hex 32
OTERO_AUTH_SECRET=<GENERATED_WITH_openssl_rand_hex_32>

# ===== 站点 =====
# 对外访问的站点 origin，用于 canonical / sitemap / OG / llms.txt。
# 需与反向代理暴露的域名一致，末尾不带斜杠。
PUBLIC_BASE_URL=https://ais-basket.xyz
